{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NZAP",
  "version": "0.1.0",
  "identifier": "com.nzaplabs.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NZAP",
        "width": 420,
        "height": 880,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost blob:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Your own Google Colab runtimes, from your phone.",
    "longDescription": "NZAP allocates and drives your own Google Colab runtimes (CPU, GPU and TPU) from your phone or tablet: run code, open a terminal, manage files, run notebooks and ephemeral jobs — no server, no account.",
    "copyright": "Copyright © NZAP Labs",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/nzap-labs/nzap-app",
    "publisher": "NZAP Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "iOS": {
      "minimumSystemVersion": "16.4"
    }
  }
}
