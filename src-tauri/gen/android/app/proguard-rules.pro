# NZAP R8 configuration (release builds). Applied together with
# proguard-tauri.pro (generated by the Tauri CLI at build time) and the
# consumer rules of every library and plugin.

# --- Reports ---------------------------------------------------------------
# Kept as CI artifacts: what R8 removed, and the merged configuration it used.
-printusage build/outputs/r8/usage.txt
-printconfiguration build/outputs/r8/configuration.txt

# Readable crash stack traces with mapping.txt, without leaking file names.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# --- Tauri / wry -----------------------------------------------------------
# The Rust side finds these classes and members by name over JNI, and plugin
# commands are dispatched by reflection on @Command methods. proguard-tauri.pro
# covers the core; these rules also cover the app package and any plugin.
-keep class app.tauri.** { *; }
-keep class com.nzaplabs.app.** { *; }
-keepclassmembers class * {
    @app.tauri.annotation.Command public *;
    @app.tauri.annotation.PermissionCallback *;
    @app.tauri.annotation.ActivityCallback *;
}
-keep @app.tauri.annotation.TauriPlugin public class * { *; }
-keep @app.tauri.annotation.InvokeArg class * { *; }
-keepclassmembers @app.tauri.annotation.InvokeArg class * { *; }

# The WebView JavaScript bridge (IPC) is called from JS by method name.
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}

# Native methods keep their JNI names.
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}

# Jackson (used by Tauri's plugin argument parsing) reads these reflectively.
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod
-dontwarn com.fasterxml.jackson.databind.ext.**
