<?xml version="1.0" encoding="utf-8"?>
<!--
  Files the app may hand to other apps (share sheet): only its own exports,
  job artifacts, logs and the share cache. Never secrets or runtime state.
-->
<paths>
    <files-path name="exports" path="exports/" />
    <files-path name="artifacts" path="artifacts/" />
    <cache-path name="share" path="share/" />
    <cache-path name="logs" path="logs/" />
</paths>
